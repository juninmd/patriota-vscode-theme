{
  "name": "patriota",
  "displayName": "patriota",
  "description": "Tema com as cores oficiais da bandeira do Brasil + um pet bandeirinha que anda pelo seu VS Code. O melhor tema para devs do Brasil.",
  "version": "0.1.0",
  "publisher": "juninmd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juninmd/patriota-vscode-theme"
  },
  "engines": {
    "vscode": "^1.72.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "brasil",
    "brazil",
    "patriota",
    "bandeira",
    "pet",
    "copilot",
    "dark"
  ],
  "galleryBanner": {
    "color": "#002776",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "patriota",
        "uiTheme": "vs-dark",
        "path": "./themes/patriota-color-theme.json"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "patriota",
          "title": "Patriota 🇧🇷",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "patriota": [
        {
          "type": "webview",
          "id": "patriota.petView",
          "name": "Bandeirinha",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "patriota.pet.show",
        "title": "Patriota: Chamar o pet Bandeirinha"
      },
      {
        "command": "patriota.pet.cheer",
        "title": "Patriota: Comemorar! 🎉"
      }
    ],
    "configuration": {
      "title": "Patriota",
      "properties": {
        "patriota.pet.size": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "default": "medium",
          "description": "Tamanho do pet Bandeirinha."
        },
        "patriota.pet.speed": {
          "type": "string",
          "enum": [
            "slow",
            "normal",
            "fast"
          ],
          "default": "normal",
          "description": "Velocidade do pet Bandeirinha."
        }
      }
    }
  },
  "scripts": {
    "package": "vsce package",
    "vscode:prepublish": "echo 'Preparing to publish'",
    "build": "mkdir -p _site && cp index.html _site/"
  },
  "devDependencies": {
    "@vscode/vsce": "^2.22.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ]
}
