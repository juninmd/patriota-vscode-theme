	"semanticHighlighting": true,
	"tokenColors": [
		{
			"name": "Comment",
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#4a5a7d",
				"fontStyle": "italic"
			}
		},
		{
			"name": "String",
			"scope": [
				"string",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#006b28"
			}
		},
		{
			"name": "Number & constant",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character"
			],
			"settings": {
				"foreground": "#8a6d00"
			}
		},
		{
			"name": "Keyword",
			"scope": [
				"keyword",
				"storage",
				"storage.type",
				"keyword.control"
			],
			"settings": {
				"foreground": "#002776",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Operator",
			"scope": [
				"keyword.operator"
			],
			"settings": {
				"foreground": "#7a5c00"
			}
		},
		{
			"name": "Function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call"
			],
			"settings": {
				"foreground": "#006b28"
			}
		},
		{
			"name": "Type / class",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.class",
				"support.type"
			],
			"settings": {
				"foreground": "#0a4fc4",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Variable",
			"scope": [
				"variable",
				"variable.other"
			],
			"settings": {
				"foreground": "#0b1c3d"
			}
		},
		{
			"name": "Parameter",
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#7a5c00",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Property",
			"scope": [
				"variable.other.property",
				"support.variable.property"
			],
			"settings": {
				"foreground": "#1a3a8f"
			}
		},
		{
			"name": "Tag",
			"scope": [
				"entity.name.tag"
			],
			"settings": {
				"foreground": "#006b28"
			}
		},
		{
			"name": "Attribute",
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#7a5c00",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markup heading",
			"scope": [
				"markup.heading",
				"entity.name.section"
			],
			"settings": {
				"foreground": "#002776",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markup inline code",
			"scope": [
				"markup.inline.raw"
			],
			"settings": {
				"foreground": "#006b28"
			}
		},
		{
			"name": "Self / this",
			"scope": [
				"variable.language"
			],
			"settings": {
				"foreground": "#7a5c00",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Invalid",
			"scope": [
				"invalid"
			],
			"settings": {
				"foreground": "#d32f2f",
				"fontStyle": "underline"
			}
		}
	]
}
